{
  "name": "workers-dns-tcp",
  "version": "0.1.0",
  "description": "An authoritative DNS server in TypeScript for Cloudflare Workers' inbound TCP handler.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:llm": "wrangler dev --env llm --port 8788 --var ASK_NAME:ask.example.test",
    "check": "wrangler types && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy": "wrangler deploy --env=\"\"",
    "test:tcp": "node --test test/tcp.integration.ts"
  },
  "dependencies": {
    "@portable/dns-packet": "0.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.166.0"
  }
}
